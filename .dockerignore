# .dockerignore -------------------------------------------------------------- #
# Author: Louis Trocellier
# Description: Files and directories excluded from the Docker build context.

# Version Control & IDE / OS files
.git
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# R / RStudio Session files
.Rproj.user
.Rhistory
.RData
.RuserData
*.Rproj
renv/library/
renv/python/
renv/sandbox/
renv/staging/

# Python Virtual Environments & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
*.egg-info/

# Environment Variables & Credentials
.env
.env.*
!.env.example
.Renviron

# Generated Data & Logs (kept on host via volumes)
logs/*
!logs/.gitkeep

data/*
!data/.gitkeep

outputs/*
!outputs/.gitkeep